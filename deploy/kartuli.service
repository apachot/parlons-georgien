[Unit]
Description=Parlons géorgien learning app
After=network.target

[Service]
Type=simple
User=parlonsgeorgien
Group=parlonsgeorgien
WorkingDirectory=/srv/parlons-georgien
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/parlons-georgien/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
